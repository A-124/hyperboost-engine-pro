<?xml version="1.0" encoding="utf-8"?>
<!-- Snapshot values are device-specific; never restore them on another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="hyperboost_snapshots.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hyperboost_snapshots.xml" />
    </device-transfer>
</data-extraction-rules>
